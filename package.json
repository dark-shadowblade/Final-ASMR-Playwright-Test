{
  "name": "final-asmr-playwright-test",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Playwright proof-of-work harness for Google Flow browser sessions",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chrome",
    "inspect": "node src/inspect-flow.js",
    "run": "node src/runner.js",
    "check": "node --check src/inspect-flow.js && node --check src/runner.js"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
