{
  "name": "final-asmr-playwright-test",
  "version": "0.1.0",
  "private": true,
  "description": "Five-account Google Flow Playwright automation",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "inspect": "node src/inspect-flow.js",
    "run": "node src/runner.js",
    "check": "node --check src/inspect-flow.js && node --check src/runner.js && node --check electron-main.cjs && node --check electron-preload.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "com.darkshadowblade.finalasmrplaywright",
    "productName": "Final ASMR Playwright",
    "directories": { "output": "release" },
    "asar": true,
    "asarUnpack": ["node_modules/playwright/**", "node_modules/playwright-core/**"],
    "files": [
      "electron-main.cjs",
      "electron-preload.cjs",
      "electron-ui.html",
      "src/**/*",
      "config/accounts.example.json",
      "prompts.example.json",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": ".pw-browsers", "to": "playwright-browsers" }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
